PROJECT_NAME=Ungozu R & D API
VERSION=1.0.0
DEBUG=false

# Use the actual Plesk MariaDB database/user values. Plesk may prefix names.
DATABASE_URL=mysql+pymysql://DB_USER:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/DB_NAME

# Generate each independently. Never commit backend/.env.
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30

# One public origin. Plesk/nginx proxies /api/v1/* to FastAPI internally.
FRONTEND_URL=https://rdp.iniakpothompson.com
BACKEND_PUBLIC_URL=https://rdp.iniakpothompson.com
MAIN_SITE_URL=https://iniakpothompson.com
CORS_ORIGINS=["https://rdp.iniakpothompson.com"]

# Gateway credentials are normally configured in the admin UI after deployment.
# These remain optional environment-variable fallbacks.
PAYMENT_ACTIVE_ENVIRONMENT=test
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

RDP_ALLOW_OUT_OF_WINDOW_APPLICATIONS=false

# Replace with your production SMTP settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=rdp@example.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=rdp@example.com
SMTP_USE_TLS=true
